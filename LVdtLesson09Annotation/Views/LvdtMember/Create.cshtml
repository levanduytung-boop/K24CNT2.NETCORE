@model LvdtMemberRegister
@{ ViewData["Title"] = "Đăng ký thành viên"; }
<h1>Đăng ký thành viên</h1><form asp-action="Create" method="post" class="card p-4 col-lg-7" novalidate>
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="mb-3"><label asp-for="LvdtUserName" class="form-label"></label><input asp-for="LvdtUserName" class="form-control" /><span asp-validation-for="LvdtUserName"></span></div>
<div class="mb-3"><label asp-for="LvdtPassword" class="form-label"></label><input asp-for="LvdtPassword" class="form-control" /><span asp-validation-for="LvdtPassword"></span></div>
<div class="mb-3"><label asp-for="LvdtEmail" class="form-label"></label><input asp-for="LvdtEmail" class="form-control" /><span asp-validation-for="LvdtEmail"></span></div>
<div class="mb-3"><label asp-for="LvdtPhoneNumber" class="form-label"></label><input asp-for="LvdtPhoneNumber" class="form-control" /><span asp-validation-for="LvdtPhoneNumber"></span></div>
<div class="mb-3"><label asp-for="LvdtFullName" class="form-label"></label><input asp-for="LvdtFullName" class="form-control" /><span asp-validation-for="LvdtFullName"></span></div>
<div class="mb-3"><label asp-for="LvdtBirthday" class="form-label"></label><input asp-for="LvdtBirthday" class="form-control" type="date" /><span asp-validation-for="LvdtBirthday"></span></div>
<button class="btn btn-primary">Đăng ký</button></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
