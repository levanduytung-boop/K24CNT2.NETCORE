
@{
    ViewData["Title"] = "Danh sách thành viên";
    int num = 0;
}

<div class="card p-3">
    <h1>@ViewData["Title"]</h1>

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>#No.</th>
                <th>Member Id</th>
                <th>User Name</th>
                <th>Full Name</th>
                <th>Email</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var member in ViewBag.Members)
            {
                num++;
                <tr>
                    <td>@num</td>
                    <td>@member.LvdtMemberId</td>
                    <td>@member.LvdtUserName</td>
                    <td>@member.LvdtFullName</td>
                    <td>@member.LvdtEmail</td>
                </tr>
            }
        </tbody>
    </table>
</div>
