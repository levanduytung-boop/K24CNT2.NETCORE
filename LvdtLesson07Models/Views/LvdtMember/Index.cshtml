@model IEnumerable<LvdtLesson07Models.Models.DataModels.LvdtMember>

@{
    ViewData["Title"] = "Danh sách thành viên";
}

<div class="card p-3">
    <h1>@ViewData["Title"]</h1>

    <p>
        <a asp-action="Create" class="btn btn-primary my-1">Thêm mới</a>
    </p>
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.LvdtMemberId)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.LvdtUserName)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.LvdtPassword)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.LvdtFullName)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.LvdtEmail)
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model) {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.LvdtMemberId)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.LvdtUserName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.LvdtPassword)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.LvdtFullName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.LvdtEmail)
                </td>
                <td>
                    @Html.ActionLink("Edit", "Edit", new { /* id=item.PrimaryKey */ }) |
                    @Html.ActionLink("Details", "Details", new { /* id=item.PrimaryKey */ }) |
                    @Html.ActionLink("Delete", "Delete", new { /* id=item.PrimaryKey */ })
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>