@model LvdtLesson07Models.Models.DataModels.LvdtMember

@{
    ViewData["Title"] = "Create";
}

<div class="card p-3">
    <h1>Thêm mới thành viên</h1>
    <hr />
    <div class="row">
        <div class="col-md-4">
            <form asp-action="Create" method="post" asp-controller="LvdtMember">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="form-group">
                    <label asp-for="LvdtMemberId" class="control-label"></label>
                    <input asp-for="LvdtMemberId" class="form-control" />
                    <span asp-validation-for="LvdtMemberId" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="LvdtUserName" class="control-label"></label>
                    <input asp-for="LvdtUserName" class="form-control" />
                    <span asp-validation-for="LvdtUserName" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="LvdtPassword" class="control-label"></label>
                    <input asp-for="LvdtPassword" class="form-control" />
                    <span asp-validation-for="LvdtPassword" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="LvdtFullName" class="control-label"></label>
                    <input asp-for="LvdtFullName" class="form-control" />
                    <span asp-validation-for="LvdtFullName" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="LvdtEmail" class="control-label"></label>
                    <input asp-for="LvdtEmail" class="form-control" />
                    <span asp-validation-for="LvdtEmail" class="text-danger"></span>
                </div>
                <div class="form-group my-2">
                    <input type="submit" value="Ghi lại" class="btn btn-primary" />
                    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
                </div>
            </form>
        </div>
    </div>
</div>