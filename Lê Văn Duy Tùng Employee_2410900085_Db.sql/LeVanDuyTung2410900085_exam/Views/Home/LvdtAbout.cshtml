@{
    ViewData["Title"] = "Thông tin sinh viên - " + ViewBag.HoTen;
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <!-- Breadcrumb -->
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb bg-white p-3 rounded-3 shadow-sm">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none"><i class="bi bi-house-door"></i> Trang chủ</a></li>
                <li class="breadcrumb-item active" aria-current="page">Thông tin sinh viên (HvtAbout)</li>
            </ol>
        </nav>

        <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
            <div class="card-header bg-gradient bg-primary text-white py-4 px-4">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                    <div>
                        <span class="badge bg-warning text-dark mb-2 px-3 py-2 fw-semibold">
                            <i class="bi bi-person-check-fill me-1"></i> BÀI KIỂM TRA THỰC HÀNH ASP.NET CORE MVC
                        </span>
                        <h2 class="mb-1 fw-bold text-white">TRANG THÔNG TIN SINH VIÊN</h2>
                        <p class="mb-0 text-white-50">Yêu cầu 3: Controller Home - Action HvtAbout</p>
                    </div>
                    <div class="text-end">
                        <span class="badge bg-light text-primary fs-6 px-3 py-2 shadow-sm">
                            <i class="bi bi-qr-code me-1"></i> MSV: @ViewBag.MaSV
                        </span>
                    </div>
                </div>
            </div>

            <div class="card-body p-4 p-md-5">
                <div class="row g-4 align-items-center">
                    <!-- Avatar and Quick Highlights -->
                    <div class="col-md-4 text-center border-end-md">
                        <div class="position-relative d-inline-block mb-3">
                            <div class="rounded-circle bg-primary bg-opacity-10 d-flex align-items-center justify-content-center mx-auto shadow-sm" style="width: 170px; height: 170px; border: 4px solid #0d6efd;">
                                <i class="bi bi-person-fill text-primary" style="font-size: 5.5rem;"></i>
                            </div>
                            <span class="position-absolute bottom-0 end-0 badge rounded-pill bg-success p-2 border border-white">
                                <i class="bi bi-patch-check-fill fs-5"></i>
                            </span>
                        </div>
                        <h4 class="fw-bold text-dark mb-1">@ViewBag.HoTen</h4>
                        <p class="text-muted mb-2">Sinh viên khoa CNTT</p>
                        <div class="d-flex justify-content-center gap-2 mb-3">
                            <span class="badge bg-primary-subtle text-primary border px-2 py-1">Lớp: @ViewBag.Lop</span>
                            <span class="badge bg-success-subtle text-success border px-2 py-1">Khóa 24</span>
                        </div>

                        <div class="d-grid gap-2">
                            <a asp-controller="LvdtStudents" asp-action="Index" class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-people-fill me-1"></i> Quản lý Sinh viên
                            </a>
                            <a asp-controller="LvdtEmployees" asp-action="Index" class="btn btn-outline-success btn-sm">
                                <i class="bi bi-person-workspace me-1"></i> Quản lý Nhân viên
                            </a>
                        </div>
                    </div>

                    <!-- Detailed Info Table -->
                    <div class="col-md-8">
                        <h5 class="fw-bold text-primary mb-3 pb-2 border-bottom">
                            <i class="bi bi-info-circle-fill me-2"></i>Chi tiết hồ sơ sinh viên
                        </h5>
                        <div class="table-responsive">
                            <table class="table table-striped table-hover align-middle mb-0">
                                <tbody>
                                    <tr>
                                        <th class="text-secondary" style="width: 35%;"><i class="bi bi-person me-2 text-primary"></i>Họ và tên:</th>
                                        <td class="fw-bold text-dark fs-6">@ViewBag.HoTen</td>
                                    </tr>
                                    <tr>
                                        <th class="text-secondary"><i class="bi bi-card-heading me-2 text-primary"></i>Mã sinh viên (MSV):</th>
                                        <td><span class="badge bg-primary fs-6 px-3 py-1">@ViewBag.MaSV</span></td>
                                    </tr>
                                    <tr>
                                        <th class="text-secondary"><i class="bi bi-mortarboard me-2 text-primary"></i>Lớp sinh hoạt:</th>
                                        <td><span class="fw-semibold text-dark">@ViewBag.Lop</span></td>
                                    </tr>
                                    <tr>
                                        <th class="text-secondary"><i class="bi bi-building me-2 text-primary"></i>Khoa / Chuyên ngành:</th>
                                        <td>@ViewBag.Khoa</td>
                                    </tr>
                                    <tr>
                                        <th class="text-secondary"><i class="bi bi-calendar3 me-2 text-primary"></i>Ngày sinh:</th>
                                        <td>@ViewBag.NgaySinh</td>
                                    </tr>
                                    <tr>
                                        <th class="text-secondary"><i class="bi bi-gender-ambiguous me-2 text-primary"></i>Giới tính:</th>
                                        <td><span class="badge bg-info text-dark"><i class="bi bi-gender-male"></i> @ViewBag.GioiTinh</span></td>
                                    </tr>
                                    <tr>
                                        <th class="text-secondary"><i class="bi bi-envelope me-2 text-primary"></i>Thư điện tử (Email):</th>
                                        <td><a href="mailto:@ViewBag.Email" class="text-decoration-none">@ViewBag.Email</a></td>
                                    </tr>
                                    <tr>
                                        <th class="text-secondary"><i class="bi bi-telephone me-2 text-primary"></i>Số điện thoại:</th>
                                        <td><a href="tel:@ViewBag.Phone" class="text-decoration-none">@ViewBag.Phone</a></td>
                                    </tr>
                                    <tr>
                                        <th class="text-secondary"><i class="bi bi-geo-alt me-2 text-primary"></i>Địa chỉ:</th>
                                        <td>@ViewBag.DiaChi</td>
                                    </tr>
                                    <tr>
                                        <th class="text-secondary"><i class="bi bi-journal-code me-2 text-primary"></i>Môn thi:</th>
                                        <td><span class="badge bg-secondary">@ViewBag.MonHoc</span></td>
                                    </tr>
                                    <tr>
                                        <th class="text-secondary"><i class="bi bi-check2-circle me-2 text-primary"></i>Trạng thái bài thi:</th>
                                        <td><span class="badge bg-success"><i class="bi bi-check-all"></i> Đã hoàn thành các yêu cầu</span></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <hr class="my-4" />

                <!-- Technology stack box -->
                <div class="p-3 bg-light rounded-3 border">
                    <h6 class="fw-bold text-dark mb-2"><i class="bi bi-cpu me-2 text-primary"></i>Công nghệ sử dụng trong đề thi:</h6>
                    <div class="d-flex flex-wrap gap-2">
                        <span class="badge bg-dark">ASP.NET Core MVC 10</span>
                        <span class="badge bg-primary">Entity Framework Core 10</span>
                        <span class="badge bg-success">Microsoft SQL Server 2022</span>
                        <span class="badge bg-info text-dark">Bootstrap 5 & Icons</span>
                        <span class="badge bg-warning text-dark">MVC Scaffolding CRUD</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
