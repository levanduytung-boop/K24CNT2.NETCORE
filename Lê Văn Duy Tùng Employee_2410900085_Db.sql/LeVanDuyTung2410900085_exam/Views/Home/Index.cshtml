@{
    ViewData["Title"] = "Trang chủ - Bài thi ASP.NET Core MVC";
}

<!-- Hero Banner -->
<div class="p-5 mb-4 bg-white rounded-4 shadow-sm border">
    <div class="container-fluid py-2">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <span class="badge bg-primary px-3 py-2 fs-6 mb-2">BÀI THI THỰC HÀNH KẾT THÚC HỌC PHẦN</span>
                <h1 class="display-5 fw-bold text-dark mb-3">ỨNG DỤNG ASP.NET CORE MVC</h1>
                <p class="fs-5 text-muted mb-4">
                    Hệ thống quản lý thông tin <strong>HvtEmployee</strong> và <strong>HvtStudent</strong> kết nối Cơ sở dữ liệu Microsoft SQL Server, xây dựng theo mô hình kiến trúc MVC với Entity Framework Core và Bootstrap 5.
                </p>
                <div class="d-flex flex-wrap gap-2">
                    <a asp-controller="Home" asp-action="HvtAbout" class="btn btn-primary btn-lg px-4">
                        <i class="bi bi-person-badge me-2"></i>Thông tin sinh viên (HvtAbout)
                    </a>
                    <a asp-controller="LvdtStudents" asp-action="Index" class="btn btn-outline-primary btn-lg px-4">
                        <i class="bi bi-people me-2"></i>Danh sách sinh viên
                    </a>
                    <a asp-controller="LvdtEmployees" asp-action="Index" class="btn btn-outline-success btn-lg px-4">
                        <i class="bi bi-person-workspace me-2"></i>Danh sách nhân viên
                    </a>
                </div>
            </div>
            <div class="col-lg-4 text-center mt-4 mt-lg-0">
                <div class="p-4 bg-light rounded-4 border">
                    <div class="mb-3">
                        <i class="bi bi-check-circle-fill text-success" style="font-size: 3.5rem;"></i>
                    </div>
                    <h5 class="fw-bold mb-1">Lê Văn Duy Tùng</h5>
                    <p class="text-muted mb-2">Mã sinh viên: <strong>2410900085</strong></p>
                    <span class="badge bg-secondary">Lớp K24CNT2</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Section Cards for the 4 requirements -->
<div class="row g-4 mb-4">
    <!-- Req 1: CSDL MSSQL -->
    <div class="col-md-6 col-lg-3">
        <div class="card h-100 border-0 shadow-sm rounded-4">
            <div class="card-body p-4 d-flex flex-column">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <span class="badge bg-primary-subtle text-primary fw-bold px-3 py-1">YÊU CẦU 1</span>
                    <i class="bi bi-database-fill-check fs-2 text-primary"></i>
                </div>
                <h5 class="card-title fw-bold">Cơ sở dữ liệu</h5>
                <p class="card-text text-muted small flex-grow-1">
                    Tạo CSDL <code>LvdtEmployee_2410900085_Db</code> với cấu trúc bảng <strong>HvtEmployee</strong>, chọn kiểu dữ liệu phù hợp và nộp file SQL script.
                </p>
                <div class="mt-3 pt-3 border-top">
                    <span class="badge bg-success-subtle text-success w-100 py-2"><i class="bi bi-check2 me-1"></i>Đã khởi tạo CSDL & Bảng</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Req 2: Project MVC Template -->
    <div class="col-md-6 col-lg-3">
        <div class="card h-100 border-0 shadow-sm rounded-4">
            <div class="card-body p-4 d-flex flex-column">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <span class="badge bg-info-subtle text-info-emphasis fw-bold px-3 py-1">YÊU CẦU 2</span>
                    <i class="bi bi-window-stack fs-2 text-info"></i>
                </div>
                <h5 class="card-title fw-bold">Ứng dụng MVC</h5>
                <p class="card-text text-muted small flex-grow-1">
                    Tạo project AspnetCore MVC với tên <code>LeVanDuyTung2410900085_exam</code> chuẩn mô hình MVC Template của Microsoft.
                </p>
                <div class="mt-3 pt-3 border-top">
                    <span class="badge bg-success-subtle text-success w-100 py-2"><i class="bi bi-check2 me-1"></i>Hoàn thành MVC Template</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Req 3: Trang HvtAbout -->
    <div class="col-md-6 col-lg-3">
        <div class="card h-100 border-0 shadow-sm rounded-4">
            <div class="card-body p-4 d-flex flex-column">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <span class="badge bg-warning-subtle text-warning-emphasis fw-bold px-3 py-1">YÊU CẦU 3</span>
                    <i class="bi bi-person-lines-fill fs-2 text-warning"></i>
                </div>
                <h5 class="card-title fw-bold">Thông tin sinh viên</h5>
                <p class="card-text text-muted small flex-grow-1">
                    Tạo link menu trên Layout tới <code>Controller: Home</code>, <code>Action: HvtAbout</code> để hiển thị thông tin sinh viên Lê Văn Duy Tùng.
                </p>
                <div class="mt-3 pt-3 border-top">
                    <a asp-controller="Home" asp-action="HvtAbout" class="btn btn-outline-warning w-100 btn-sm fw-semibold">
                        <i class="bi bi-arrow-right-circle me-1"></i>Xem trang HvtAbout
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Req 4: Scaffolding CRUD -->
    <div class="col-md-6 col-lg-3">
        <div class="card h-100 border-0 shadow-sm rounded-4">
            <div class="card-body p-4 d-flex flex-column">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <span class="badge bg-success-subtle text-success fw-bold px-3 py-1">YÊU CẦU 4</span>
                    <i class="bi bi-table fs-2 text-success"></i>
                </div>
                <h5 class="card-title fw-bold">CRUD Scaffolding</h5>
                <p class="card-text text-muted small flex-grow-1">
                    Sử dụng scaffolding tạo các chức năng Thêm - Xem - Sửa - Xóa (CRUD) với giao diện Bootstrap 5 đẹp mắt, thân thiện.
                </p>
                <div class="mt-3 pt-3 border-top">
                    <a asp-controller="LvdtStudents" asp-action="Index" class="btn btn-outline-success w-100 btn-sm fw-semibold">
                        <i class="bi bi-arrow-right-circle me-1"></i>Thao tác CRUD
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
