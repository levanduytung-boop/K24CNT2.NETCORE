@model LeVanDuyTung2410900085_exam.Models.LvdtEmployee

@{
    ViewData["Title"] = "Chỉnh sửa nhân viên";
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb bg-white p-3 rounded-3 shadow-sm">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index"><i class="bi bi-house-door"></i> Trang chủ</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Danh sách nhân viên</a></li>
        <li class="breadcrumb-item active" aria-current="page">Chỉnh sửa #@Model.Id</li>
    </ol>
</nav>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="card-header bg-warning text-dark py-3 px-4">
                <h4 class="mb-0 fw-bold"><i class="bi bi-pencil-square me-2"></i>CHỈNH SỬA THÔNG TIN NHÂN VIÊN</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                    <input type="hidden" asp-for="Id" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Mã nhân viên (Id)</label>
                        <input value="@Model.Id" class="form-control bg-light" readonly />
                    </div>

                    <div class="mb-3">
                        <label asp-for="LvdtName" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-person"></i></span>
                            <input asp-for="LvdtName" class="form-control" />
                        </div>
                        <span asp-validation-for="LvdtName" class="text-danger small"></span>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="LvdtGender" class="form-label fw-semibold"></label>
                            <select asp-for="LvdtGender" class="form-select">
                                <option value="true">Nam</option>
                                <option value="false">Nữ</option>
                            </select>
                            <span asp-validation-for="LvdtGender" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LvdtBirthDay" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-calendar"></i></span>
                                <input asp-for="LvdtBirthDay" type="date" class="form-control" />
                            </div>
                            <span asp-validation-for="LvdtBirthDay" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="LvdtEmail" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                                <input asp-for="LvdtEmail" type="email" class="form-control" />
                            </div>
                            <span asp-validation-for="LvdtEmail" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LvdtPhone" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-telephone"></i></span>
                                <input asp-for="LvdtPhone" class="form-control" />
                            </div>
                            <span asp-validation-for="LvdtPhone" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" asp-for="LvdtActive" />
                            <label class="form-check-label fw-semibold" asp-for="LvdtActive">Trạng thái hoạt động</label>
                        </div>
                    </div>

                    <div class="d-flex gap-2 justify-content-end border-top pt-3">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i> Quay lại
                        </a>
                        <button type="submit" class="btn btn-warning px-4 fw-semibold">
                            <i class="bi bi-check-lg me-1"></i> Cập nhật thay đổi
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
